# ===========================================
# Ward-Chat Environment Variables
# ===========================================

# Database
DATABASE_URL="postgresql://ward:wardpass@localhost:5432/ward_chat?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="wardminio"
S3_SECRET_KEY="wardminiopass"
S3_BUCKET="ward-chat"
S3_REGION="us-east-1"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-secure-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth - GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Socket.IO Service
SOCKET_SERVER_URL="http://localhost:3001"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NODE_ENV="development"
